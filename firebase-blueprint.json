{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered member profile of The Light of Akwa Ibom",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Full name of the member" },
        "email": { "type": "string", "description": "Member email" },
        "photoUrl": { "type": "string", "description": "Profile picture URL or avatar" },
        "lga": { "type": "string", "description": "Local Government Area in Akwa Ibom" },
        "occupation": { "type": "string", "description": "Profession or craft" },
        "bio": { "type": "string", "description": "Member bio and motto" },
        "status": { "type": "string", "description": "Online or offline status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "GroupMessage": {
      "title": "Community Group Message",
      "description": "Real-time message in the shared Akwa Ibom community group chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "voice"] },
        "mediaData": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "text", "type", "createdAt"]
    },
    "DirectMessage": {
      "title": "Direct Private Message",
      "description": "Private 1-on-1 message between two members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "voice"] },
        "mediaData": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "receiverId", "text", "type", "createdAt"]
    },
    "CallSession": {
      "title": "Audio or Video Call Session",
      "description": "Signaling document for one-to-one voice or video call",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "callType": { "type": "string", "enum": ["audio", "video"] },
        "status": { "type": "string", "enum": ["ringing", "accepted", "rejected", "ended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callerId", "receiverId", "callType", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Member profile directory"
    },
    "/group_messages/{messageId}": {
      "schema": { "$ref": "#/entities/GroupMessage" },
      "description": "Community group conversation channel"
    },
    "/direct_messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Direct 1-on-1 private messaging"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Real-time voice and video call signaling sessions"
    }
  }
}
